{
  "name": "senda",
  "version": "0.1.0",
  "private": true,
  "description": "SENDA — plataforma de aprendizaje gamificada. Maqueta front-only: App del alumno + Studio del administrador.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "shadows": "node scripts/check-solid-shadows.mjs",
    "inline-size": "node scripts/check-inline-script-size.mjs",
    "budgets": "node scripts/check-budgets.mjs",
    "tokens": "node --experimental-strip-types scripts/emit-tokens.mts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm css-vars && pnpm shadows && pnpm build && pnpm budgets",
    "phase-report": "node scripts/gen-phase-report.mjs",
    "css-vars": "node scripts/check-css-vars.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.10",
    "canvas-confetti": "1.9.4",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "immer": "11.1.18",
    "lucide-react": "1.41.0",
    "motion": "13.2.0",
    "next": "15.5.25",
    "nuqs": "2.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "recharts": "3.10.1",
    "seedrandom": "3.0.5",
    "sonner": "2.0.8",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/seedrandom": "3.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
